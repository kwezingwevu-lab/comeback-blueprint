{
  "name": "comeback-blueprint",
  "private": true,
  "version": "2026.09.28",
  "description": "The Comeback Blueprint - single-file HTML fitness app (Kwezi). Factory, QA suites, PWA layer, calendar helper.",
  "scripts": {
    "check": "node --check src/app_full.js",
    "build": "python3 build.py",
    "qa": "bash qa/run.sh",
    "webkit": "npx playwright install webkit",
    "qa:webkit": "node qa/webkit.js",
    "qa:pwa": "node qa/pwa.js",
    "qa:sweep": "node qa/sweep.js",
    "icons": "node src/pwa/make-icons.js",
    "calendar": "node tools/calendar-refresh.js --geocode",
    "calendar:selftest": "node tools/calendar-refresh.js --selftest"
  },
  "devDependencies": {
    "puppeteer": "^24.0.0",
    "playwright": "^1.50.0"
  }
}
